# NEXUS | HUB
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # در صورت نیاز (مثلاً اگر آدرس‌ها کار نکرد) خط زیر را فعال و مسیر را تنظیم کنید:
    # RewriteBase /nexushub/

    # جلوگیری از دسترسی مستقیم به پوشه app
    RewriteRule ^app(/|$) - [F,L]
    # پوشه‌ی داخلی پنل
    RewriteRule ^admin/inc(/|$) - [F,L]
    # فایل‌های مخفی (.git, .env, .htaccess …) — به‌جز .well-known
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    # ربات‌هایی که دنبال وردپرس / phpMyAdmin و … می‌گردن، بدون اجرای سایت رد می‌شن
    RewriteRule ^(wp-login\.php|wp-admin|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|myadmin|adminer|vendor/|cgi-bin) - [F,L,NC]
    # روش‌های TRACE / TRACK بسته
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)$
    RewriteRule .* - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# فایل‌های پشتیبان، دیتابیس، لاگ و فشرده هیچ‌وقت دانلود نمی‌شن
<FilesMatch "\.(sql|sqlite|db|log|bak|old|orig|save|swp|ini|env|sh|dist|lock|zip|tar|gz|tgz|7z|rar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

AddType font/woff2 .woff2
